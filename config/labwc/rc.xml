<?xml version="1.0" ?>
<labwc_config>
  <keyboard>
    <default />

<keybind key="W-l" name.action="Execute" command.action="swaylock -c 000000"/>


<keybind key="W-s">
  <action name="Execute">
    <command>sh -c 'grim -g "$(slurp)" ~/Images/screenshot-$(date +%Y-%m-%d-%H%M%S).png'</command>
  </action>
</keybind>

<keybind key="W-f">
  <action name="ToggleFullscreen" />
</keybind>

<keybind key="W-e">
  <action name="Execute" command="dolphin" />
</keybind>
<keybind key="W-v">
  <action name="Execute" command="virt-manager" />
</keybind>
<keybind key="W-c">
  <action name="Execute" command="code" />
</keybind>
    <!-- App launcher -->
    <keybind key="W-d">
      <action name="Execute" command="rofi -show drun" />
    </keybind>

    <!-- Brightness control -->
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl -e set +5%" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl -e set 5%-" />
    </keybind>

    <!-- Volume control -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>
  </keyboard>
 <libinput>
    <device category="touchpad">
      <pointerSpeed>0.7</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>
<theme>
  <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
</theme>

</labwc_config>
