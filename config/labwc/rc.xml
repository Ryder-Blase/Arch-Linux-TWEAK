<?xml version="1.0" ?>
<labwc_config>
  <keyboard>
    <default />
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="MoveToEdge" direction="left" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="MoveToEdge" direction="right" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="MoveToEdge" direction="up" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="MoveToEdge" direction="down" snapWindows="yes" />
    </keybind>
    <keybind key="W-r">
      <action name="SnapToRegion" region="my-custom-region" />
    </keybind>
    <keybind key="W-l" name.action="Execute" command.action="swaylock -c 000000"/>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" ~/Images/screenshot-$(date +%Y-%m-%d-%H%M%S).png'</command>
      </action>
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="virt-manager" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="code" />
    </keybind>
    <!-- App launcher -->
    <keybind key="W-d">
      <action name="Execute" command="rofi -show drun" />
    </keybind>
    <!-- Brightness control -->
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl -e set +5%" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl -e set 5%-" />
    </keybind>
    <!-- Volume control -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>
  </keyboard>

  <libinput>
    <device category="touchpad">
      <pointerSpeed>1.5</pointerSpeed>
      <accelProfile>adaptative</accelProfile>
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>

  <theme>
    <cornerRadius>0</cornerRadius>
    <name>MyTheme</name>
    <titlebar>
      <layout>:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
  </theme>

  <core>
    <decoration>server</decoration>
    <gap>5</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>yes</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
  </core>

  <focus>
    <focusNew>no</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <windowRules>
    <windowRule identifier="*">
      <action name="AutoPlace"/>
      <fixedPosition>no</fixedPosition>
    </windowRule>
  </windowRules>

  <regions>
    <region name="my-custom-region" x="50%" y="0%" width="50%" height="50%"/>
    <region name="top-left" x="0%" y="0%" width="50%" height="50%"/>
    <region name="top-right" x="50%" y="0%" width="50%" height="50%"/>
    <region name="bottom-left" x="0%" y="50%" width="50%" height="50%"/>
    <region name="bottom-right" x="50%" y="50%" width="50%" height="50%"/>
  </regions>

  <placement>
    <policy>automatic</policy>
  </placement>
</labwc_config>
